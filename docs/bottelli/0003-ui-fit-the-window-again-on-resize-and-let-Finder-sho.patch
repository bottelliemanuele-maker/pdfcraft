         self.last_session = last_session::LastSession::from_json(&v["last_session"]);
         if let Some(on) = v["system_title_bar"].as_bool() {
             self.system_title_bar = on;
diff --git a/packaging/macos/Info.plist.in b/packaging/macos/Info.plist.in
index cfc7d2d..70d526e 100644
--- a/packaging/macos/Info.plist.in
+++ b/packaging/macos/Info.plist.in
@@ -59,8 +59,9 @@
       <string>Editor</string>
       <key>LSHandlerRank</key>
       <string>Alternate</string>
-      <key>CFBundleTypeIconFile</key>
-      <string>PdfCraft</string>
+      <!-- No CFBundleTypeIconFile: with a custom document icon Finder shows that icon for every
+           PDF once PdfCraft is the default app, instead of the page thumbnail Quick Look renders.
+           Without it Finder keeps the thumbnail, as it does with Preview. -->
       <key>LSItemContentTypes</key>
       <array><string>com.adobe.pdf</string></array>
       <key>CFBundleTypeExtensions</key>
